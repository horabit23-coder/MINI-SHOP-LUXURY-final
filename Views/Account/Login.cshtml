
@model MINI_SHOP_LUXURY.Models.LoginViewModel

@{
    Layout = null;
    ViewBag.Title = "Dang nhap";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>MINI SHOP & LUXURY - Dang nhap</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: Arial, sans-serif;
            background: #f7f5ef;
        }

        .login-box {
            width: 100%;
            max-width: 450px;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 35px rgba(0,0,0,.09);
        }

        .logo {
            text-align: center;
            font-size: 25px;
            font-weight: bold;
            color: #bd9633;
            margin-bottom: 15px;
        }

        h2 {
            text-align: center;
            color: #111;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #888;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 9px;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-size: 15px;
            outline: none;
            background: white;
        }

        input:focus {
            border-color: #bd9633;
            box-shadow: 0 0 0 2px #bd963322;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 14px;
            color: #555;
            margin-bottom: 22px;
        }

            .remember input {
                width: 16px;
                height: 16px;
                accent-color: #bd9633;
            }

        .login-btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 7px;
            background: #111;
            color: #d4af37;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

            .login-btn:hover {
                background: #bd9633;
                color: #111;
            }

        /* Chi hien thi khung khi co loi */
        .validation-summary-valid {
            display: none !important;
        }

        .validation-summary-errors {
            color: #c62828;
            background: #fff0f0;
            padding: 12px;
            border-radius: 7px;
            margin-bottom: 18px;
            font-size: 13px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 20px;
            }

        .field-error {
            display: block;
            color: #c62828;
            font-size: 13px;
            margin-top: 6px;
        }

            .field-error:empty {
                display: none;
            }

        .links {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
            line-height: 2;
        }

            .links a {
                color: #99751e;
                text-decoration: none;
                font-weight: bold;
            }

                .links a:hover {
                    text-decoration: underline;
                }

        @@media(max-width: 500px) {
            .login-box {
                padding: 28px 22px;
            }
        }
    </style>
</head>

<body>

    <div class="login-box">

        <div class="logo">
            <i class="fa-solid fa-crown"></i>
            MINI SHOP & LUXURY
        </div>

        <h2>&#272;&#258;NG NH&#7852;P</h2>

        <p class="subtitle">
            Ch&#224;o m&#7915;ng b&#7841;n quay tr&#7903; l&#7841;i!
        </p>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

            <div class="form-group">
                <label>Email</label>

                @Html.TextBoxFor(m => m.Email, new
                {
                    type = "email",
                    placeholder = "example@gmail.com",
                    autocomplete = "email",
                    maxlength = "254",
                    required = "required",
                    oninput = "this.value=this.value.replace(/\\s/g,'')"
                })

                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
            </div>

            <div class="form-group">
                <label>M&#7853;t kh&#7849;u</label>

                @Html.PasswordFor(m => m.Password, new
                {
                    placeholder = "Nhap mat khau",
                    autocomplete = "current-password",
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
            </div>

            <label class="remember">
                @Html.CheckBoxFor(m => m.RememberMe)
                Ghi nh&#7899; &#273;&#259;ng nh&#7853;p
            </label>

            <button type="submit" class="login-btn">
                <i class="fa-solid fa-right-to-bracket"></i>
                &#272;&#258;NG NH&#7852;P
            </button>
        }

        <div class="links">
            Ch&#432;a c&#243; t&#224;i kho&#7843;n?
            <a href="@Url.Action("Register", "Account")">
                &#272;&#259;ng k&#253; ngay
            </a>

            <br />

            <a href="@Url.Action("Index", "Home")">
                <i class="fa-solid fa-house"></i>
                Quay l&#7841;i trang ch&#7911;
            </a>
        </div>

    </div>

</body>
</html>
