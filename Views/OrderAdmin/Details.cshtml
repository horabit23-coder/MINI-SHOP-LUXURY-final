
@model System.Data.DataTable
@using System
@using System.Data

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = null;

    DataRow order = ViewBag.Order as DataRow;

    int orderId = Convert.ToInt32(order["OrderId"]);
    string customerName = Convert.ToString(order["CustomerName"]);
    string phone = Convert.ToString(order["Phone"]);
    string address = Convert.ToString(order["Address"]);
    string status = Convert.ToString(order["OrderStatus"]);
    string paymentMethod = Convert.ToString(order["PaymentMethod"]);
    string paymentStatus = Convert.ToString(order["PaymentStatus"]);

    bool isPaid = paymentStatus == "Đã thanh toán";
    bool isCancelled = status == "Đã hủy";

    string paymentMethodText =
        paymentMethod == "BANK"
        ? "Chuyển khoản BIDV (VietQR)"
        : paymentMethod == "COD"
        ? "Thanh toán khi nhận hàng (COD)"
        : paymentMethod;

    decimal totalAmount = Convert.ToDecimal(order["TotalAmount"]);
    DateTime createdAt = Convert.ToDateTime(order["CreatedAt"]);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chi tiết đơn hàng #@orderId</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f5f5;
            color: #111;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #101010;
            color: white;
            padding: 28px 18px;
        }

        .brand {
            text-align: center;
            font-size: 21px;
            font-weight: bold;
            letter-spacing: 2px;
            line-height: 1.5;
            margin-bottom: 40px;
        }

            .brand small {
                display: block;
                color: #aaa;
                font-size: 12px;
                font-weight: normal;
            }

        .menu a {
            display: block;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 7px;
            color: #ddd;
            text-decoration: none;
            font-size: 14px;
        }

            .menu a i {
                width: 24px;
            }

            .menu a:hover,
            .menu a.active {
                background: white;
                color: #111;
            }

        .main {
            margin-left: 250px;
            padding: 35px;
        }

        .back {
            display: inline-block;
            margin-bottom: 22px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
        }

        h1 {
            margin: 0 0 10px;
            font-size: 28px;
        }

        .subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 28px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .panel {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 24px;
        }

            .panel h2 {
                margin: 0 0 20px;
                font-size: 19px;
            }

        .info-row {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .info-label {
            min-width: 145px;
            color: #777;
        }

        .info-value {
            font-weight: bold;
            overflow-wrap: anywhere;
        }

        .payment-badge {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: bold;
        }

        .paid {
            background: #e6f6e9;
            color: #177a35;
        }

        .unpaid {
            background: #fff1dc;
            color: #a35b00;
        }

        .confirm-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 18px;
            padding: 14px 22px;
            background: #111;
            color: white;
            border: 0;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

            .confirm-btn:hover {
                background: #333;
            }

        .payment-note {
            color: #777;
            font-size: 13px;
            line-height: 1.7;
            margin-top: 15px;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: #e6f6e9;
            color: #177a35;
        }

        .alert-error {
            background: #ffe7e7;
            color: #a32121;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 15px 12px;
            border-bottom: 1px solid #eee;
            text-align: left;
            font-size: 14px;
        }

        th {
            background: #f7f7f7;
            color: #555;
        }

        .price {
            white-space: nowrap;
            font-weight: bold;
        }

        .total {
            margin-top: 24px;
            text-align: right;
            font-size: 22px;
            font-weight: bold;
        }

        .empty {
            padding: 35px;
            color: #777;
            text-align: center;
        }

        @@media (max-width: 850px) {
            .sidebar {
                position: static;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }

            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <aside class="sidebar">
        <div class="brand">
            MINI SHOP
            <br />
            &amp; LUXURY
            <small>ADMIN PANEL</small>
        </div>

        <nav class="menu">
            <a href="@Url.Action("Index", "Admin")">
                <i class="fa-solid fa-gauge-high"></i>
                Tổng quan
            </a>

            <a href="@Url.Action("Index", "CategoryAdmin")">
                <i class="fa-solid fa-list"></i>
                Quản lý danh mục
            </a>

            <a href="@Url.Action("Index", "ProductAdmin")">
                <i class="fa-solid fa-box"></i>
                Quản lý sản phẩm
            </a>

            <a class="active"
               href="@Url.Action("Index", "OrderAdmin")">
                <i class="fa-solid fa-receipt"></i>
                Quản lý đơn hàng
            </a>

            <a href="@Url.Action("Index", "Home")">
                <i class="fa-solid fa-store"></i>
                Đi đến trang bán hàng
            </a>

            <a href="@Url.Action("Logout", "Account")"
               style="margin-top: 24px; border-top: 1px solid #444; padding-top: 20px;">
                <i class="fa-solid fa-right-from-bracket"></i>
                Đăng xuất
            </a>
        </nav>
    </aside>

    <main class="main">
        <a class="back"
           href="@Url.Action("Index", "OrderAdmin")">
            <i class="fa-solid fa-arrow-left"></i>
            Quay lại danh sách đơn hàng
        </a>

        <h1>Chi tiết đơn hàng #@orderId</h1>
        <p class="subtitle">
            Thông tin chi tiết về đơn hàng của khách.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
        }

        <div class="grid">
            <section class="panel">
                <h2>
                    <i class="fa-solid fa-user"></i>
                    Thông tin khách hàng
                </h2>

                <div class="info-row">
                    <span class="info-label">Họ tên:</span>
                    <span class="info-value">@customerName</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Điện thoại:</span>
                    <span class="info-value">@phone</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Địa chỉ:</span>
                    <span class="info-value">@address</span>
                </div>
            </section>

            <section class="panel">
                <h2>
                    <i class="fa-solid fa-receipt"></i>
                    Thông tin đơn hàng
                </h2>

                <div class="info-row">
                    <span class="info-label">Mã đơn:</span>
                    <span class="info-value">#@orderId</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Ngày đặt:</span>
                    <span class="info-value">
                        @createdAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-label">Trạng thái:</span>
                    <span class="info-value">@status</span>
                </div>
            </section>
        </div>

        <section class="panel">
            <h2>
                <i class="fa-solid fa-credit-card"></i>
                Quản lý thanh toán
            </h2>

            <div class="info-row">
                <span class="info-label">Phương thức:</span>
                <span class="info-value">@paymentMethodText</span>
            </div>

            <div class="info-row">
                <span class="info-label">Số tiền:</span>
                <span class="info-value">
                    @totalAmount.ToString("N0") ₫
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Thanh toán:</span>
                <span>
                    @if (isPaid)
                    {
                        <span class="payment-badge paid">
                            <i class="fa-solid fa-circle-check"></i>
                            Đã thanh toán
                        </span>
                    }
                    else
                    {
                        <span class="payment-badge unpaid">
                            <i class="fa-solid fa-clock"></i>
                            Chưa thanh toán
                        </span>
                    }
                </span>
            </div>

            @if (!isPaid && !isCancelled)
            {
                using (Html.BeginForm(
                    "ConfirmPayment",
                    "OrderAdmin",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@orderId" />

                    <button type="submit"
                            class="confirm-btn"
                            onclick="return confirm('Bạn đã kiểm tra và chắc chắn nhận được tiền thanh toán cho đơn hàng này?');">
                        <i class="fa-solid fa-check-circle"></i>
                        XÁC NHẬN ĐÃ THANH TOÁN
                    </button>
                }

                <p class="payment-note">
                    Chỉ xác nhận khi đã kiểm tra nhận được tiền
                    chuyển khoản BIDV hoặc đã thu tiền COD.
                </p>
            }
            else if (isCancelled)
            {
                <p class="payment-note">
                    Đơn hàng đã hủy, không thể xác nhận thanh toán.
                </p>
            }
            else
            {
                <p class="payment-note">
                    Đơn hàng này đã được xác nhận thanh toán.
                </p>
            }
        </section>

        <section class="panel">
            <h2>
                <i class="fa-solid fa-box"></i>
                Sản phẩm trong đơn hàng
            </h2>

            @if (Model == null || Model.Rows.Count == 0)
            {
                <div class="empty">
                    Đơn hàng chưa có thông tin sản phẩm.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 0;
                            }

                            @foreach (DataRow item in Model.Rows)
                            {
                                stt++;

                                string productName =
                                    Convert.ToString(item["ProductName"]);

                                int quantity =
                                    Convert.ToInt32(item["Quantity"]);

                                decimal unitPrice =
                                    Convert.ToDecimal(item["UnitPrice"]);

                                decimal subtotal =
                                    Convert.ToDecimal(item["Subtotal"]);

                                <tr>
                                    <td>@stt</td>
                                    <td>@productName</td>
                                    <td>@quantity</td>
                                    <td class="price">
                                        @unitPrice.ToString("N0") ₫
                                    </td>
                                    <td class="price">
                                        @subtotal.ToString("N0") ₫
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="total">
                Tổng cộng: @totalAmount.ToString("N0") ₫
            </div>
        </section>
    </main>
</body>
</html>
