
@{
    Layout = null;
    ViewBag.Title = "Đặt hàng thành công";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Đặt hàng thành công - MINI SHOP & LUXURY</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px 15px;
            background: #f5f5f5;
            font-family: Arial, sans-serif;
            color: #171717;
        }

        .container {
            max-width: 620px;
            margin: 45px auto;
            background: white;
            border-radius: 16px;
            padding: 45px 35px;
            text-align: center;
            box-shadow: 0 10px 35px rgba(0,0,0,.08);
        }

        .brand {
            font-size: 20px;
            font-weight: bold;
            letter-spacing: 3px;
            margin-bottom: 35px;
        }

        .success-icon {
            width: 90px;
            height: 90px;
            margin: 0 auto 25px;
            border-radius: 50%;
            background: #e9f8ee;
            color: #198754;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: bold;
        }

        h1 {
            font-size: 28px;
            margin-bottom: 12px;
        }

        .description {
            color: #666;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .order-info {
            background: #f8f8f8;
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 20px;
            text-align: left;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 12px 0;
            border-bottom: 1px solid #e5e5e5;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            color: #666;
        }

        .info-value {
            font-weight: bold;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .total {
            font-size: 20px;
            color: #111;
        }

        .payment-note {
            margin-top: 25px;
            padding: 15px;
            border-radius: 10px;
            background: #fff8e8;
            color: #795500;
            line-height: 1.6;
        }

        .home-button {
            display: block;
            margin-top: 30px;
            padding: 17px;
            background: #111;
            color: white;
            text-decoration: none;
            border-radius: 9px;
            font-weight: bold;
            transition: background .2s;
        }

            .home-button:hover {
                background: #333;
            }

        @@media (max-width: 480px) {
            .container {
                padding: 30px 18px;
                margin: 10px auto;
            }

            h1 {
                font-size: 23px;
            }

            .info-row {
                flex-direction: column;
                gap: 5px;
            }

            .info-value {
                text-align: left;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="brand">
            MINI SHOP & LUXURY
        </div>

        <div class="success-icon">
            ✓
        </div>

        <h1>ĐẶT HÀNG THÀNH CÔNG!</h1>

        <p class="description">
            Cảm ơn bạn đã mua sắm tại MINI SHOP & LUXURY.
            Đơn hàng của bạn đã được ghi nhận và
            đang chờ cửa hàng xác nhận.
        </p>

        <div class="order-info">

            <div class="info-row">
                <span class="info-label">Mã đơn hàng</span>
                <span class="info-value">
                    #@ViewBag.OrderId
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Người nhận</span>
                <span class="info-value">
                    @ViewBag.CustomerName
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Số điện thoại</span>
                <span class="info-value">
                    @ViewBag.Phone
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Địa chỉ giao hàng</span>
                <span class="info-value">
                    @ViewBag.Address
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Phương thức thanh toán</span>
                <span class="info-value">
                    Thanh toán khi nhận hàng (COD)
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Trạng thái</span>
                <span class="info-value">
                    @ViewBag.OrderStatus
                </span>
            </div>

            <div class="info-row">
                <span class="info-label">Tổng tiền</span>
                <span class="info-value total">
                    @Convert.ToDecimal(ViewBag.TotalAmount).ToString("N0") ₫
                </span>
            </div>

        </div>

        <div class="payment-note">
            Bạn chỉ cần thanh toán cho nhân viên giao hàng
            khi nhận được sản phẩm.
        </div>

        <a href="@Url.Action("Index", "Home")"
           class="home-button">
            TIẾP TỤC MUA SẮM
        </a>

    </div>

</body>
</html>
