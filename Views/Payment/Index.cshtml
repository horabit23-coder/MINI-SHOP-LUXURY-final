
@using System

@{
    ViewBag.Title = "Thanh toán BIDV";
    Layout = null;

    int orderId = Convert.ToInt32(ViewBag.OrderId);
    decimal amount = Convert.ToDecimal(ViewBag.Amount);

    string bankName = Convert.ToString(ViewBag.BankName);
    string bankAccount = Convert.ToString(ViewBag.BankAccount);
    string accountName = Convert.ToString(ViewBag.AccountName);
    string transferContent =
        Convert.ToString(ViewBag.TransferContent);
    string qrUrl = Convert.ToString(ViewBag.QrUrl);
    string paymentStatus =
        Convert.ToString(ViewBag.PaymentStatus);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Thanh toán BIDV - MINI SHOP &amp; LUXURY</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 35px 15px;
            background: #f4f4f4;
            color: #111;
            font-family: Arial, sans-serif;
        }

        .payment-box {
            max-width: 540px;
            margin: auto;
            background: #fff;
            padding: 35px;
            border: 1px solid #e5e5e5;
            border-radius: 16px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.05);
        }

        .brand {
            text-align: center;
            font-size: 23px;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .subtitle {
            text-align: center;
            margin: 12px 0 25px;
            color: #777;
            font-size: 14px;
        }

        .order-code {
            text-align: center;
            background: #111;
            color: #fff;
            padding: 16px;
            border-radius: 9px;
            margin-bottom: 25px;
        }

        .qr {
            display: block;
            width: 100%;
            max-width: 320px;
            height: auto;
            margin: 0 auto 20px;
        }

        .amount {
            font-size: 29px;
            font-weight: bold;
            text-align: center;
            margin: 15px 0 25px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

            .info-row span:first-child {
                color: #777;
            }

            .info-row strong {
                text-align: right;
                overflow-wrap: anywhere;
            }

        .notice {
            background: #f5f5f5;
            padding: 18px;
            margin-top: 25px;
            border-radius: 9px;
            font-size: 13px;
            line-height: 1.8;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 16px;
            margin-top: 15px;
            text-align: center;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
        }

        .btn-dark {
            background: #111;
            color: #fff;
        }

        .btn-light {
            background: #eee;
            color: #111;
        }

        @@media (max-width: 480px) {
            .payment-box {
                padding: 22px;
            }

            .info-row {
                flex-direction: column;
                gap: 5px;
            }

                .info-row strong {
                    text-align: left;
                }
        }
    </style>
</head>

<body>

    <div class="payment-box">

        <div class="brand">
            MINI SHOP &amp; LUXURY
        </div>

        <div class="subtitle">
            Thanh toán chuyển khoản ngân hàng
        </div>

        <div class="order-code">
            MÃ ĐƠN HÀNG: #@orderId
        </div>

        @if (paymentStatus == "Đã thanh toán")
        {
            <div class="notice">
                Đơn hàng này đã được xác nhận thanh toán.
            </div>
        }
        else
        {
            <img class="qr"
                 src="@qrUrl"
                 alt="Mã QR chuyển khoản BIDV" />

            <div class="amount">
                @amount.ToString("N0") ₫
            </div>

            <div class="info-row">
                <span>Ngân hàng</span>
                <strong>@bankName</strong>
            </div>

            <div class="info-row">
                <span>Số tài khoản</span>
                <strong>@bankAccount</strong>
            </div>

            <div class="info-row">
                <span>Chủ tài khoản</span>
                <strong>@accountName</strong>
            </div>

            <div class="info-row">
                <span>Nội dung chuyển khoản</span>
                <strong>@transferContent</strong>
            </div>

            <div class="info-row">
                <span>Trạng thái</span>
                <strong>@paymentStatus</strong>
            </div>

            <div class="notice">
                <strong>Hướng dẫn thanh toán:</strong>
                <ol>
                    <li>Mở ứng dụng ngân hàng.</li>
                    <li>Chọn chức năng quét mã QR.</li>
                    <li>Kiểm tra tên người nhận và số tiền.</li>
                    <li>Thực hiện chuyển khoản.</li>
                </ol>

                Sau khi chuyển khoản, đơn hàng vẫn ở trạng thái
                chờ xác nhận cho đến khi Admin kiểm tra đã nhận tiền.
                Không cần chuyển khoản lần thứ hai.
            </div>
        }

        <a class="btn btn-dark"
           href="@Url.Action("Index", "Home")">
            Về trang chủ
        </a>

        <a class="btn btn-light"
           href="@Url.Action("Index", "Home")">
            Tiếp tục mua sắm
        </a>

    </div>

</body>
</html>
